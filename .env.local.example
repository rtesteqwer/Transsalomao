# ============================================
# TRANS SALOMÃO - EXEMPLO DE VARIÁVEIS
# Nunca coloque chaves reais neste arquivo.
# ============================================

# OpenAI usada pela Salomão IA / OCR
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo dedicado ao leitor de tickets.
# Padrão do código: gpt-4o-mini
OPENAI_OCR_MODEL=gpt-4o-mini

# Modelo do assistente Salomão IA (demais funções)
OPENAI_ASSISTANT_MODEL=gpt-5.6-sol

# Neon PostgreSQL
DATABASE_URL=postgresql://xxxxxxxxxxxxxxxxxxxxxxxx

# Sessão segura da gerência
MANAGEMENT_SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Token opcional para integrações internas / motorista
TICKET_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
