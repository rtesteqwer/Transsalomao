+async function readKlebersomFleetState(sql: Awaited<ReturnType<typeof getSql>>): Promise<FleetState> {
+  const driverRows = await sql<Record<string, unknown>>`
+    select * from drivers
+    where lower(name) in ('klebersom dutra', 'klebesom dutra')
+       or lower(name) like 'kleber% dutra'
+    order by case when lower(name) = 'klebersom dutra' then 0 else 1 end, name
+    limit 1
+  `;
+  const fleetRows = await sql<Record<string, unknown>>`
+    select * from fleets
+    where lower(name) = 'volvo klebersom'
+       or (lower(name) like '%volvo%' and lower(name) like '%kleber%')
+    order by case when lower(name) = 'volvo klebersom' then 0 else 1 end, name
+    limit 1
+  `;
+
+  const driver = driverRows[0];
+  const fleet = fleetRows[0];
+  if (!driver || !fleet) {
+    return {
+      drivers: driver ? [mapDriver(driver)] : [],
+      fleets: fleet ? [mapFleet(fleet)] : [],
+      trips: [],
+      reports: [],
+      fuelings: [],
+    };
+  }
+
+  const driverId = str(driver.id);
+  const fleetId = str(fleet.id);
+  const [trips, reports, fuelings] = await Promise.all([
+    sql<Record<string, unknown>>`
+      select * from trips
+      where driver_id = ${driverId} and fleet_id = ${fleetId}
+      order by date desc, code desc
+    `,
+    sql<Record<string, unknown>>`
+      select * from reports
+      where driver_id = ${driverId} and fleet_id = ${fleetId}
+      order by created_at desc
+    `,
+    sql<Record<string, unknown>>`
+      select * from fuelings
+      where fleet_id = ${fleetId} and (driver_id = ${driverId} or driver_id is null)
+      order by date desc, created_at desc
+    `,
+  ]);
+
+  return {
+    drivers: [mapDriver(driver)],
+    fleets: [mapFleet(fleet)],
+    trips: trips.map(mapTrip),
+    reports: reports.map(mapReport),
+    fuelings: fuelings.map(mapFueling),
+  };
+}
+
+export const getKlebersomFleetState = createServerFn({ method: "GET" }).handler(
+  async (): Promise<FleetState> => {
+    const { assertPartnerOrAdminSession } = await import("@/lib/management-auth.server");
+    assertPartnerOrAdminSession();
+    const sql = await getSql();
+    return readKlebersomFleetState(sql);
+  },
+);
