+
+export type ReportExpense = Expense & {
+  driverName: string;
+  fleetName: string;
+  assetLabel: string;
+};
+
+function drawFinancialDetailsPage(page: PdfPage, trips: ComputedTrip[], expenses: ReportExpense[], top = 132) {
+  page.text("Comissões por motorista", MARGIN, topToY(top), { size: 14, bold: true, color: colors.fg });
+  const byDriver = new Map<string, { freight: number; commission: number }>();
+  for (const trip of trips) {
+    const row = byDriver.get(trip.driverName) ?? { freight: 0, commission: 0 };
+    row.freight += trip.freight;
+    row.commission += trip.commissionValue;
+    byDriver.set(trip.driverName, row);
+  }
+  let y = top + 26;
+  if (byDriver.size === 0) {
+    page.text("Sem comissões no período.", MARGIN, topToY(y), { size: 9, color: colors.muted });
+    y += 22;
+  } else {
+    for (const [name, row] of [...byDriver.entries()].sort((a, b) => b[1].commission - a[1].commission)) {
+      page.text(truncate(name, 32), MARGIN, topToY(y), { size: 9.5, bold: true, color: colors.fg });
+      page.text(`Frete ${brl(row.freight)}  |  Comissão ${brl(row.commission)}  |  Após comissão ${brl(row.freight - row.commission)}`, MARGIN + 180, topToY(y), { size: 8.5, color: colors.muted });
+      y += 18;
+    }
+  }
+  y += 12;
+  page.text("Despesas no período", MARGIN, topToY(y), { size: 14, bold: true, color: colors.fg });
+  y += 24;
+  if (expenses.length === 0) {
+    page.text("Sem despesas registradas no período.", MARGIN, topToY(y), { size: 9, color: colors.muted });
+    return;
+  }
+  for (const expense of expenses.slice(0, 24)) {
+    const target = expense.assetType === "driver" ? `Motorista: ${expense.driverName}` : `${expense.assetLabel}: ${expense.fleetName}`;
+    page.text(`${formatDate(expense.date)}  |  ${truncate(expense.category, 18)}  |  ${truncate(target, 34)}`, MARGIN, topToY(y), { size: 8.5, color: colors.fg });
+    page.text(brl(expense.amount), MARGIN + CONTENT_W - 80, topToY(y), { size: 9, bold: true, color: colors.accent });
+    y += 17;
+    if (y > 760) break;
+  }
+}
